rules_version = '2';

// Only the people listed here can read or change BuddyBoard data.
// Put in the exact email addresses of the accounts created under
// Firebase console → Authentication → Users, then publish these rules
// (Firestore Database → Rules → paste → Publish).
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeam() {
      return request.auth != null
        && request.auth.token.email in [
          'jij@example.com',
          'compagnon@example.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isTeam();
    }
  }
}
